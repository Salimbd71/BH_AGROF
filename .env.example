# Firebase ওয়েব কনফিগ (Firebase Console -> Project settings -> Your apps -> Web app)
# দুটো সাইটেই (SR ও Admin) হুবহু একই মান দিন। এটা গোপন তথ্য নয়।
# Netlify/Cloudflare-এ: Site settings -> Environment variables-এ এগুলো বসান।
# লোকাল টেস্টের জন্য এই ফাইলটা .env.local নামে কপি করে মান বসাতে পারেন।
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_DATABASE_URL="https://YOUR-PROJECT-default-rtdb.firebaseio.com"
VITE_FIREBASE_PROJECT_ID=""
